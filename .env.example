# Archive Scout developer environment template. Never commit a populated .env file.
# Select openai or openrouter.
AI_PROVIDER=openai

# Choose a model explicitly for reproducible AI review.
AI_MODEL=gpt-5-mini

OPENAI_API_KEY=
OPENROUTER_API_KEY=

AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=1200

# Optional OpenRouter attribution.
OPENROUTER_HTTP_REFERER=https://github.com/DearStrike4940/archive-scout
OPENROUTER_APP_TITLE=Archive Scout
